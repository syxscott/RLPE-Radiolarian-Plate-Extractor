# =============================================================================
# MiniMax M3 API configuration (Anthropic-compatible)
# =============================================================================
# Get your subscription key at:
#   https://platform.minimaxi.com/user-center/payment/token-plan
#
# IMPORTANT:
#   - 订阅 Key (Token Plan) 与 按量计费 API Key 不互通。
#   - 复制本文件为 .env 然后填入真实 Key（.env 已在 .gitignore 中）。
#   - 切勿将真实 Key 提交到 git！
# -----------------------------------------------------------------------------

# Token Plan subscription key (required when llm_backend=MiniMax)
ANTHROPIC_API_KEY=sk-cp-REPLACE_WITH_YOUR_REAL_MINIMAX_KEY

# Anthropic-compatible endpoint for MiniMax
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Model name (default: MiniMax-M3)
ANTHROPIC_MODEL=MiniMax-M3
