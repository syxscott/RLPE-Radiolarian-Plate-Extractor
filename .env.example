# =============================================================================
# LLM API configuration (Anthropic-compatible, provider-agnostic — F17)
# =============================================================================
# RLPE works with ANY provider that speaks the Anthropic wire protocol
# (MiniMax, DeepSeek, Kimi, OpenRouter's /anthropic route, Claude
# relays, ...). Three ways to configure, in priority order:
#
#   1. Per-run flags:            --llm-api-key / --llm-base-url / --llm-model
#   2. Saved settings (shared by the Web UI and the desktop GUI,
#      stored at ~/.rlpe/llm_api.json with mode 0600)
#   3. This .env file (values below win over OS env for these keys)
#
# IMPORTANT:
#   - 复制本文件为 .env 然后填入真实 Key（.env 已在 .gitignore 中）。
#   - 切勿将真实 Key 提交到 git！
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_API_KEY

# Anthropic-compatible endpoint of your provider, e.g.
#   MiniMax:    https://api.minimaxi.com/anthropic
#   DeepSeek:   https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Your provider's model name, e.g. MiniMax-M3 / deepseek-chat
ANTHROPIC_MODEL=MiniMax-M3

# Legacy vendor-branded env names (MiniMax_API_KEY / MINIMAX_API_KEY /
# MiniMax_MODEL / MiniMax_BASE_URL) are still honoured as read-only
# fallbacks, but ANTHROPIC_* above is the canonical set.
