    "/jobs/{job_id}/stream": {
      "get": {
        "description": "Server-Sent Events stream of job progress.\n\naudit 2026-08-19 phase 5e (M-25): the polling ``/jobs/{id}/status``\nendpoint above is fine for the dev console but not for the live\nweb UI \u2014 a 1-5s polling cadence wastes a connection per tab and\nmisses progress updates between polls. SSE pushes every status\nchange the moment the worker writes it, and ``EventSource`` is\nbuilt into every browser (no library needed).\n\nWire format: ``text/event-stream`` with one event per status tick:\n\n    data: {\"job_id\": \"...\", \"status\": \"running\", \"progress\": 42, ...}\\n\\n\n\nThe stream closes after the job reaches a terminal state\n(``done`` / ``failed`` / ``cancelled``). 404 jobs emit one\n``not_found`` event then close. Clients should treat any\nstream-closed event as \"stop polling\".",
        "operationId": "stream_job_progress_jobs__job_id__stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Job Progress"
      }
    },
