    "/results": {
      "delete": {
        "description": "Clear every result row across every done job.\n\nKeeps the job metadata (so ``/jobs`` listings, ``/system/info``\ntotals, and any in-flight pipeline runs are unaffected). Returns\nthe total number of rows removed.\n\naudit 2026-08-01 W1 / M19: now also rewrites ``matches.jsonl``\nfor each affected job so a server restart reloads the empty\nstate. Previously only ``job[\"result\"]`` was mutated in memory,\nso the on-disk ``matches.jsonl`` retained the rows and the next\n``_load_existing_jobs_from_disk()`` call would resurrect them\non restart \u2014 confusing for the operator who tried to clear the\ntable.",
        "operationId": "delete_all_results_results_delete",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Delete All Results Results Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete All Results"
      },
      "get": {
        "description": "Get all accumulated results from completed jobs.\n\nRound 23 audit: this endpoint previously returned the FULL\nresult set with no pagination. With 1000+ panels across many\njobs, the response could be huge (causing frontend lag or\ntimeouts). The new ``?limit=N&offset=M`` query params enable\npagination. ``limit`` is capped at 5000 to prevent abuse.\n\nThe response is ordered by ``(job_id, paper_id, figure_id,\npanel_id)`` so pagination is stable across requests. The\nresponse headers are NOT extended with a total-count link\nbecause computing it would require walking all rows anyway;\nthe frontend asks for the next page until an empty page is\nreturned (length 0) \u2014 implicit pagination.",
        "operationId": "get_results_results_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ResultRecord"
                  },
                  "title": "Response Get Results Results Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Results"
      }
    },
