# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project runtime artifacts
uploads/
service_work/
/work/
output/
# YOLO training dataset + Ultralytics run outputs (large
# binaries / cache / model weights; regenerated by training scripts).
data/yolo_dataset/
runs/

# User-downloaded test corpora (large; kept on disk for offline runs
# but never committed). The "放射虫论文_OA_download" folder holds the
# 187-paper / 820 MB radiolarian corpus downloaded by the user; we
# reference it from scripts/ but never want git to track it.
放射虫论文_OA_download/
test_oa_*/
test_papers*/
test_robust/

# Exception: committed baseline prediction files used by the eval-smoke
# CI job. These live in work/ for runtime convenience but are committed
# as small (4 MB) snapshots so the CI can re-run the eval without
# re-executing the full pipeline. The git index captures them via
# `git add -f work/combined_*_FINAL.jsonl`.
!work/combined_*_FINAL.jsonl
!work/combined_*_v*.jsonl

# Model weights and large binaries
*.pt
*.pth
*.gguf
*.bin
*.onnx
*.safetensors

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
# Reject any file that might accidentally contain a credential, even
# ones that don't match the names above (e.g. a stray "credentials.txt"
# or "secrets.json" that an operator dropped into the repo).
**/credentials.*
**/secrets.*
**/secrets.json
**/credentials.json
**/*.secret

# API integration logs
MiniMax_usage.log
MiniMax_costs.log
# Pipeline server output logs that may carry request IDs or cost data
# (not sensitive on its own, but combined with timing can correlate
# with API requests).
service_work/*.log
uploads/*.log
# Local-only development scratch scripts (created by the
# agent during iterative edits; safe to remove).
scratch_*.py
